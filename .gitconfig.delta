# delta como pager do git. Inclua no ~/.gitconfig com:
#   git config --global include.path ~/.gitconfig.delta
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	dark = true
	syntax-theme = ansi
[merge]
	conflictStyle = zdiff3
